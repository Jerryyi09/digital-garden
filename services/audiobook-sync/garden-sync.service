[Unit]
Description=Rosemary Garden audiobook user sync
After=network-online.target docker.service

[Service]
Type=simple
Environment=GARDEN_SYNC_DB=%h/.local/share/garden-sync/sync.sqlite3
Environment=GARDEN_SYNC_HOST=172.19.0.1
Environment=GARDEN_SYNC_PORT=8791
Environment=GARDEN_ALIST_ME=http://127.0.0.1:5244/alist/api/me
ExecStart=/usr/bin/python3 %h/.local/lib/garden-sync/server.py
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
