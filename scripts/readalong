#!/usr/bin/env bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

VENV_DIR="$PROJECT_ROOT/tools/readalong/.venv"
PYTHON="$VENV_DIR/bin/python"

if [ ! -f "$PYTHON" ]; then
  echo "Bootstrapping tools/readalong virtual environment..."
  if command -v uv >/dev/null 2>&1; then
    uv venv "$VENV_DIR" --python /opt/homebrew/bin/python3
    VIRTUAL_ENV="$VENV_DIR" uv pip install \
      --default-index https://pypi.tuna.tsinghua.edu.cn/simple \
      -r "$PROJECT_ROOT/private/audiobook-validation/power-of-habit/runtime-snapshot/requirements-macos-arm64.txt"
  else
    python3 -m venv "$VENV_DIR"
    "$VENV_DIR/bin/pip" install -r "$PROJECT_ROOT/private/audiobook-validation/power-of-habit/runtime-snapshot/requirements-macos-arm64.txt"
  fi
fi

export PYTHONPATH="$PROJECT_ROOT:$PYTHONPATH"
export TOKENIZERS_PARALLELISM="false"
export OMP_NUM_THREADS="4"

exec "$PYTHON" -m tools.readalong.cli "$@"
